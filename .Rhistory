)
# Plot the relationship between R1 biomass and grain yield
ggplot(
AllData,
aes(
x = biomass_R1_Mg_ha,
y = grain_yield_Mg_ha
)
) +
geom_point() +
labs(
x = "Biomass at R1 (Mg/ha)",
y = "Grain yield (Mg/ha)"
) +
theme_bw()
# Select variables for the correlation analysis
cor_data <- AllData %>%
select(S_rate_kg_ha:N_conc_R1_pct)
# Calculate the Pearson correlation matrix
M <- cor(
cor_data,
method = "pearson",
use = "pairwise.complete.obs"
)
# Display the correlation matrix
round(M, 2)
# Visualize the Pearson correlation matrix
corrplot(
M,
method = "color",
type = "lower",
order = "original",
tl.col = "black",
tl.srt = 45,
addCoef.col = "black",
diag = FALSE
)
