# Import Excel files
library(readxl)
# Select and manipulate variables
library(dplyr)
# Create graphs
library(ggplot2)
# Fit linear mixed-effects models
library(lme4)
# Obtain Kenward-Roger tests
library(lmerTest)
# Estimate marginal means
library(emmeans)
# Create compact letter displays
library(multcomp)
# Fit the linear-plateau model
model_LP <- nls(
grain_yield_Mg_ha ~ SSlinp(
S_rate_kg_ha,
a,
b,
xs
),
data = AllData
)
# Import Excel data
library(readxl)
# Create graphs
library(ggplot2)
# Fit nonlinear response models
library(nlraa)
# More robust nonlinear least-squares fitting
library(minpack.lm)
# Import the workshop dataset
AllData <- read_excel(
"data/Data_example.xlsx",
sheet = "data"
)
# Check the data structure
str(AllData)
# Plot grain yield against sulfur rate
ggplot(
AllData,
aes(
x = S_rate_kg_ha,
y = grain_yield_Mg_ha
)
) +
geom_point(size = 2.5) +
labs(
x = "Sulfur rate (kg S ha⁻¹)",
y = "Grain yield (Mg ha⁻¹)"
) +
theme_bw()
# Fit the linear-plateau model
model_LP <- nls(
grain_yield_Mg_ha ~ SSlinp(
S_rate_kg_ha,
a,
b,
xs
),
data = AllData
)
# Display model results
summary(model_LP)
# Fit the quadratic-plateau model
model_QP <- nls(
grain_yield_Mg_ha ~ SSquadp3xs(
S_rate_kg_ha,
a,
b,
xs
),
data = AllData
)
# Display model results
summary(model_QP)
# Fit the linear-plateau model
model_LP <- nls(
grain_yield_Mg_ha ~ SSlinp(
S_rate_kg_ha,
a,
b,
xs
),
data = AllData
)
# Display model results
summary(model_LP)
# Fit the quadratic-plateau model
model_QP <- nls(
grain_yield_Mg_ha ~ SSquadp3xs(
S_rate_kg_ha,
a,
b,
xs
),
data = AllData
)
# Display model results
summary(model_QP)
# Compare the LP and QP models using AIC
AIC(
model_LP,
model_QP
)
# Create sulfur rates for prediction
new_data <- data.frame(
S_rate_kg_ha = seq(
min(AllData$S_rate_kg_ha),
max(AllData$S_rate_kg_ha),
length.out = 200
)
)
# Predict grain yield using the LP model
new_data$LP <- predict(
model_LP,
newdata = new_data
)
# Predict grain yield using the QP model
new_data$QP <- predict(
model_QP,
newdata = new_data
)
# Plot observations and fitted nonlinear models
ggplot() +
geom_point(
data = AllData,
aes(
x = S_rate_kg_ha,
y = grain_yield_Mg_ha
),
size = 2.5
) +
geom_line(
data = new_data,
aes(
x = S_rate_kg_ha,
y = LP,
linetype = "Linear-plateau"
),
linewidth = 1
) +
geom_line(
data = new_data,
aes(
x = S_rate_kg_ha,
y = QP,
linetype = "Quadratic-plateau"
),
linewidth = 1
) +
labs(
x = "Sulfur rate (kg S ha⁻¹)",
y = "Grain yield (Mg ha⁻¹)",
linetype = "Model"
) +
theme_bw()
# Extract the estimated breakpoint from each model
breakpoints <- data.frame(
Model = c(
"Linear-plateau",
"Quadratic-plateau"
),
Breakpoint = c(
coef(model_LP)["xs"],
coef(model_QP)["xs"]
)
)
# Display the estimated breakpoints
breakpoints
