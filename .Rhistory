install.packages("multcompView")
# Import Excel files
library(readxl)
# Select and manipulate variables
library(dplyr)
# Create graphs
library(ggplot2)
# Fit linear mixed-effects models
library(lme4)
# Obtain Kenward-Roger tests
library(lmerTest)
# Estimate marginal means
library(emmeans)
# Create compact letter displays
library(multcomp)
library(multcompView)
# Import the workshop dataset
AllData <- read_excel(
"Data_example.xlsx",
sheet = "data"
)
# Check the structure of the dataset
str(AllData)
# Convert sulfur rate to a treatment factor
AllData$S_rate_kg_ha <- factor(AllData$S_rate_kg_ha)
# Convert block to a grouping factor
AllData$block <- factor(AllData$block)
# Fit the linear mixed-effects model
model <- lmer(
grain_yield_Mg_ha ~ S_rate_kg_ha + (1 | block),
data = AllData,
REML = TRUE
)
# Display the model summary
summary(model)
# Test the fixed effect using Kenward-Roger degrees of freedom
anova(
model,
ddf = "Kenward-Roger"
)
# Estimate marginal means using Kenward-Roger degrees of freedom
means <- emmeans(
model,
~ S_rate_kg_ha,
lmer.df = "kenward-roger"
)
# Display the estimated means
means
# Create compact letter display
results <- cld(
means,
Letters = letters,
lmer.df = "kenward-roger",
sort = FALSE
) %>%
as.data.frame() %>%
mutate(
letter = trimws(.group)
)
# Display the treatment means and letters
results
# Plot estimated means with 95% confidence intervals
ggplot(
results,
aes(
x = S_rate_kg_ha,
y = emmean
)
) +
geom_point(size = 3) +
geom_errorbar(
aes(
ymin = lower.CL,
ymax = upper.CL
),
width = 0.15
) +
geom_text(
aes(
y = upper.CL,
label = letter
),
vjust = -0.5,
size = 5
) +
labs(
x = "Sulfur rate (kg S/ha)",
y = "Estimated grain yield (Mg/ha)"
) +
theme_bw()
# Create fitted values and residuals
diagnostic_data <- data.frame(
fitted = fitted(model),
residual = resid(model)
)
# Plot residuals against fitted values
ggplot(
diagnostic_data,
aes(
x = fitted,
y = residual
)
) +
geom_point() +
geom_hline(
yintercept = 0,
linetype = "dashed"
) +
labs(
x = "Fitted values",
y = "Residuals"
) +
theme_bw()
renv::snapshot()
renv::status()
install.packages("pbkrtest")
library(pbkrtest)
file.exists("renv.lock")
renv::status()
renv::snapshot()
renv::status()
"pbkrtest" %in% rownames(renv::dependencies())
packageVersion("pbkrtest")
renv::install("pbkrtest")
renv::snapshot()
"pbkrtest" %in% names(renv::lockfile_read()$Packages)
